{
  // Must match the Worker's name in Cloudflare (Workers & Pages → holisplit), which Cloudflare's builds use
  "name": "holisplit",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // The normal workers.dev address, plus a separate test address for each branch's preview build
  "workers_dev": true,
  "preview_urls": true,
  // The page is built from src/ before every deploy and preview upload, whatever the dashboard's build settings say
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Workers AI for receipt scanning (free daily allowance: 10,000 neurons)
  "ai": {
    "binding": "AI"
  },
  // Keep logs for a few days (Workers & Pages → holiday-split → Observability / Logs)
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "TRIPS",
      "id": "89724cbf43f3482293324be801af3893"
    }
  ],
  // Preview builds (any branch other than main) use their own storage, so testing never touches real trips
  "previews": {
    "kv_namespaces": [
      {
        "binding": "TRIPS",
        "id": "55408dfa05ca4a5db5d00c7703f5ad41"
      }
    ],
    "ai": {
      "binding": "AI"
    }
  }
}
